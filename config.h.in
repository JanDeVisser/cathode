#ifndef __CONFIG_H__
#define __CONFIG_H__

#define CATHODE_NAME "@cathode_NAME@"
#define CATHODE_VERSION_MAJOR "@cathode_VERSION_MAJOR@"
#define CATHODE_VERSION_MINOR "@cathode_VERSION_MINOR@"
#define CATHODE_VERSION_PATCH "@cathode_VERSION_PATCH@"
#define CATHODE_VERSION "@cathode_VERSION"
#define CATHODE_APPDIR "@cathode_APPDIR@"
#define CATHODE_DATADIR "@cathode_DATADIR@"
#define CATHODE_CPU "@CMAKE_SYSTEM_PROCESSOR@"
#define CATHODE_SYSTEM "@CMAKE_SYSTEM_NAME@"
#define CATHODE_SYSTEM_VERSION "@CMAKE_SYSTEM_VERSION@"
#define CATHODE_COMPILER "@CMAKE_CXX_COMPILER_ID@"

#cmakedefine IS_APPLE 1
#cmakedefine IS_LINUX 1
#cmakedefine IS_WINDOWS 1

#cmakedefine IS_ARM64 1
#cmakedefine IS_X86_64 1

#endif /* __CONFIG_H__ */
